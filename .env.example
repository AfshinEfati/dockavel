# Host user mapping for bind-mounted project files (Linux / WSL2)
UID=1000
GID=1000

# Runtime versions
PHP_VERSION=8.3
NODE_VERSION=22

# Optional host port overrides
NGINX_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379
TRAEFIK_DASHBOARD_PORT=8081

# Local development database
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=laravel
MYSQL_USER=laravel
MYSQL_PASSWORD=secret

# Shared Docker network name
DOCKAVEL_NETWORK=dockavel

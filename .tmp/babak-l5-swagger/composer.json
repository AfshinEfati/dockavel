{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "Temporary dependency-resolution workspace for the babak_back L5-Swagger installation (publish verification).",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "astrotomic/laravel-translatable": "^11.17",
        "darkaonline/l5-swagger": "^11.1",
        "filament/filament": "^5.6",
        "filament/spatie-laravel-media-library-plugin": "^5.6",
        "laravel/framework": "^13.8",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-permission": "^8.1",
        "symfony/clock": "^7.2",
        "symfony/console": "^7.2",
        "symfony/error-handler": "^7.2",
        "symfony/event-dispatcher": "^7.2",
        "symfony/finder": "^7.2",
        "symfony/html-sanitizer": "^7.2",
        "symfony/http-foundation": "^7.2",
        "symfony/http-kernel": "^7.2",
        "symfony/mailer": "^7.2",
        "symfony/mime": "^7.2",
        "symfony/process": "^7.2",
        "symfony/routing": "^7.2",
        "symfony/string": "^7.2",
        "symfony/translation": "^7.2",
        "symfony/uid": "^7.2",
        "symfony/var-dumper": "^7.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
